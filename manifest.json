{
  "manifest_version": 3,
  "name": "study scheduler extension",
  "version": "1.0",
  "permissions": [
    "alarms",
    "notifications",
    "storage"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": "icons/icon.png"
  },
  "icons": {
    "48": "icons/icon.png",
    "128": "icons/icon.png"
  },
  "web_accessible_resources": [
    {
      "resources": ["data/*.json", "icons/*.png"],
      "matches": ["<all_urls>"]
    }
  ]
}

